{
  "name": "gqlmd-telemetry",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.scripts.config.ts",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "lint": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist --config worker/wrangler.jsonc",
    "dev": "wrangler dev --config worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "typescript": "7.0.2",
    "vitest": "4.1.0",
    "wrangler": "4.142.0"
  }
}
