{
  "name": "gqlmd-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": false },

  // Public hostname. Custom domains work with the Cache API (quarantine);
  // workers.dev does not. The zone must already be on this Cloudflare account.
  "routes": [
    { "pattern": "telemetry.graphql-markdown.dev", "custom_domain": true }
  ],

  // Analytics Engine: raw events and payload-free reject counters.
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "gqlmd_events" },
    { "binding": "REJECTS", "dataset": "gqlmd_rejects" }
  ],

  // Rate limits keyed by `${fp}:${colo}`. RL (100 per 60 s) trips a quarantine;
  // RL_HARD (1000 per 60 s) is the quota-protection ceiling: over it, sampled 1/20 and flagged.
  "ratelimits": [
    {
      "name": "RL",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      // Per colo only (key `colo:${colo}`), checked before parsing the body.
      "name": "RL_COLO",
      "namespace_id": "1003",
      "simple": { "limit": 2000, "period": 60 }
    },
    {
      "name": "RL_HARD",
      "namespace_id": "1002",
      "simple": { "limit": 1000, "period": 60 }
    }
  ],

  // Daily rollup target. database_id is a placeholder for local and test runs;
  // the deployed binding is created by infra/worker.tofu.
  // Migrations: `wrangler d1 migrations apply gqlmd-telemetry --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gqlmd-telemetry",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],

  // Rollup of day D-1 (UTC).
  "triggers": { "crons": ["0 2 * * *"] }

  // Secrets (not in this file): AE_SQL_TOKEN, ACCOUNT_ID, ALERT_WEBHOOK.
}
