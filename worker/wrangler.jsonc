{
  "name": "gqlmd-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": false },

  // Public hostname. Custom domains work with the Cache API (quarantine);
  // workers.dev does not. The zone must already be on this Cloudflare account.
  "routes": [
    { "pattern": "telemetry.graphql-markdown.dev", "custom_domain": true }
  ],

  // Analytics Engine: raw events and payload-free reject counters.
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "gqlmd_events" },
    { "binding": "REJECTS", "dataset": "gqlmd_rejects" }
  ],

  // Rate limits keyed by `${fp}:${colo}`. RL (100 per 60 s) trips a quarantine;
  // RL_HARD (1000 per 60 s) is the quota-protection ceiling: over it, drop.
  "ratelimits": [
    {
      "name": "RL",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      // Per colo only (key `colo:${colo}`), checked before parsing the body.
      "name": "RL_COLO",
      "namespace_id": "1003",
      "simple": { "limit": 2000, "period": 60 }
    },
    {
      "name": "RL_HARD",
      "namespace_id": "1002",
      "simple": { "limit": 1000, "period": 60 }
    }
  ]

  // Bindings are declared in later PRs:
  // "d1_databases": [{ "binding": "DB", "database_name": "gqlmd-telemetry", "database_id": "..." }],
  // "triggers": { "crons": ["0 3 * * *"] },
}
