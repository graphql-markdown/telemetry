{
  "name": "gqlmd-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": false },

  // Public hostname. Custom domains work with the Cache API (quarantine);
  // workers.dev does not. The zone must already be on this Cloudflare account.
  "routes": [
    { "pattern": "telemetry.graphql-markdown.dev", "custom_domain": true }
  ],

  // Analytics Engine: raw events and payload-free reject counters.
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "gqlmd_events" },
    { "binding": "REJECTS", "dataset": "gqlmd_rejects" }
  ]

  // Bindings are declared in later PRs:
  // "d1_databases": [{ "binding": "DB", "database_name": "gqlmd-telemetry", "database_id": "..." }],
  // "triggers": { "crons": ["0 3 * * *"] },
}
