{
  "name": "gqlmd-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": false },

  // Ingest Worker, served on workers.dev (the account has no zone, so no routes or custom
  // domains). The dashboard is a second Worker built from the same bundle:
  // wrangler.dashboard.jsonc, behind Cloudflare Access.
  "workers_dev": true,
  "preview_urls": false,

  // Picks the routes this Worker serves: /v1/event and the cron.
  // Also set by infra/worker.tofu; unset (wrangler dev, tests) it serves everything.
  "vars": { "ROLE": "ingest" },

  // Analytics Engine: raw events and payload-free reject counters.
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "gqlmd_events" },
    { "binding": "REJECTS", "dataset": "gqlmd_rejects" }
  ],

  // Rate limits keyed by `${fp}:${colo}`. RL (100 per 60 s) trips a quarantine;
  // RL_HARD (1000 per 60 s) is the quota-protection ceiling: over it, sampled 1/20 and flagged.
  "ratelimits": [
    {
      "name": "RL",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      // Per colo only (key `colo:${colo}`), checked before parsing the body.
      "name": "RL_COLO",
      "namespace_id": "1003",
      "simple": { "limit": 2000, "period": 60 }
    },
    {
      "name": "RL_HARD",
      "namespace_id": "1002",
      "simple": { "limit": 1000, "period": 60 }
    }
  ],

  // Quarantine flags (key `q:${fp}:${colo}`, TTL 1 h). The Cache API does not work on
  // workers.dev, so the flag lives in KV. id is a placeholder for local and test runs;
  // scripts/deploy.sh substitutes the real one from `tofu output quarantine_kv_id`.
  "kv_namespaces": [
    { "binding": "QUARANTINE", "id": "00000000000000000000000000000001" }
  ],

  // Daily rollup target. database_id is a placeholder for local and test runs;
  // the deployed binding is created by infra/worker.tofu.
  // Deploy and remote migrations go through scripts/deploy.sh, which substitutes the real id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gqlmd-telemetry",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],

  // Vars set by infra/worker.tofu are kept across deploys; local defaults live in
  // worker/.dev.vars.example.
  "keep_vars": true,

  // Rollup of day D-1 (UTC).
  "triggers": { "crons": ["0 2 * * *"] }

  // Secrets (not in this file): AE_SQL_TOKEN, ACCOUNT_ID, ALERT_WEBHOOK.
}
